# 荣珂评测任务集 v0（种子）—— 每行一个 JSON 任务，本行及以 # 开头的行是注释。
# 判据设计纪律：checks 里只放**可程序化判定**的东西（文件在不在 / 工具真调没调 / 字数区间 /
#   门该不该拦 / 步数上限）。"结论对不对" 不在这里 —— 它需要专家盲评，另算成本。
# status: ready = 今天就能跑；needs-fixture = 需先备材料（材料路径写 fixtures/）。
{"id":"w1-short-plain","bucket":"write-short","status":"ready","max_steps":12,"goal":"写一段约 120 字的论文引言草稿，主题是冬虫夏草人工培育的主要难点。不需要检索文献。","checks":[{"kind":"chars_range","min":102,"max":138},{"kind":"tool_ok","tool":"load_skill","min":1},{"kind":"gate","expect":"pass"}],"why":"已有 7 次历史运行，是唯一有重复的任务 ⇒ 基线参照点"}
{"id":"w1-short-cited","bucket":"write-short","status":"ready","max_steps":16,"goal":"写一段约 200 字的引言，主题是冬虫夏草子实体人工诱导的研究现状，需要给出 2 条真实可核验的文献支撑（必须核验 DOI）。","checks":[{"kind":"chars_range","min":170,"max":230},{"kind":"tool_ok","tool":"verify_citation","min":2},{"kind":"gate","expect":"pass"}],"why":"考的是「引文必须真核过」这条链会不会断在写作阶段"}
{"id":"w1-short-forbidden-cite","bucket":"write-short","status":"ready","max_steps":10,"goal":"写一段约 150 字的摘要，说明低温诱导对子实体分化的作用。不要引用任何文献。","checks":[{"kind":"chars_range","min":128,"max":173},{"kind":"tool_absent","tool":"literature_search"},{"kind":"tool_absent","tool":"verify_citation"},{"kind":"gate","expect":"pass"}],"why":"负控：模型会不会无视「不要引用」去做时髦动作。★ 这条已实测跑过（20260919-092312）：6 步 / 147 字 / 100 分 / 零检索调用 ⇒ 负控通过；且实测 cache_r=61824(89.6%) 验证了缓存口径修复"}
{"id":"w1-short-english","bucket":"write-short","status":"ready","max_steps":12,"goal":"Write a 120-word abstract paragraph on cold-shock induced fruiting body differentiation in Ophiocordyceps sinensis. No citations needed.","checks":[{"kind":"chars_range","min":600,"max":900},{"kind":"gate","expect":"pass"}],"why":"英文按词不按字的口径是否真的生效"}
{"id":"w1-short-overlong","bucket":"write-short","status":"ready","max_steps":14,"goal":"写一段约 100 字的正文，介绍蝙蝠蛾幼虫饲养的温湿度窗口。","checks":[{"kind":"gate","expect":"pass"},{"kind":"chars_range","min":85,"max":115}],"why":"字数目标抽取 + 内核自测覆盖（不许比对模型措辞）"}
{"id":"w2-long-review","bucket":"write-long","status":"needs-fixture","max_steps":28,"goal":"写一篇 1800–2200 字的综述小节「冬虫夏草人工培育的关键瓶颈」，至少 3 节、至少 8 条引文，全部引文必须核验 DOI 后写入参考文献。","checks":[{"kind":"chars_range","min":1800,"max":2200},{"kind":"file_exists","path":"draft.md"},{"kind":"tool_ok","tool":"verify_citation","min":8},{"kind":"gate","expect":"pass"}],"why":"长稿走 draft_path 这条路目前**零实测**（119 字那篇是内联的）"}
{"id":"w2-long-methods","bucket":"write-long","status":"needs-fixture","max_steps":28,"goal":"为一篇实验论文写「方法」一节，约 1500 字，包含菌种分离、寄主接种、低温诱导三段，每段给出可复现参数。","checks":[{"kind":"chars_range","min":1350,"max":1650},{"kind":"file_exists","path":"draft.md"},{"kind":"gate","expect":"pass"}],"why":"方法节最容易被模型写成套话，考稿面门在长稿上的灵敏度"}
{"id":"w2-long-mixed-cite","bucket":"write-long","status":"needs-fixture","max_steps":30,"goal":"写「讨论」一节约 1600 字，要求引注按正文首现顺序编号，并与参考文献表一一对应。","checks":[{"kind":"file_exists","path":"draft.md"},{"kind":"gate","expect":"pass"}],"why":"引注首现序是已有检查，但从未在 1000 字以上稿子上测过"}
